# Production Environment Variables
# Copy this file to backend/.env and customize as needed

# Server Configuration
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://ytd.heidari.ca

# Downloads are never expired on a timer — media stays until its owner removes
# it, and the per-user quota (users.max_storage_bytes) bounds disk use. There is
# no MAX_FILE_AGE_HOURS any more; the hourly sweep only reconciles the table.

# Optional: Logging Level
# LOG_LEVEL=info
